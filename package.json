{
  "name": "fall-fest-map",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build-sw.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "sync": "git pull --ff-only && npm install",
    "start": "git pull --ff-only && npm install && vite",
    "test:e2e": "npm run build && node scripts/test.mjs",
    "shots": "vite build && (vite preview --port 4310 & sleep 4 && node scripts/shot.mjs; kill %1)",
    "print": "vite build && node scripts/build-sw.mjs && node scripts/print.mjs",
    "test:visual": "npm run build && node scripts/test.mjs --visual-only",
    "pr-shots": "node scripts/pr-shots.mjs"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.56.0",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4",
    "vite": "^8.2.2"
  }
}
